# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

set $mod Mod4
default_border pixel 2
default_floating_border pixel 2

# 这些参考一下吧。。 我是双屏触摸笔记本bro用不到可以删掉 我先注释掉了
# 触摸屏映射到对应输出
# input "1267:11291:ELAN9009:00_04F3:2C1B" map_to_output DP-1
# input "1267:11605:ELAN9008:00_04F3:2D55" map_to_output eDP-1
# input "1267:11291:ELAN9009:00_04F3:2C1B_Stylus" map_to_output DP-1
# input "1267:11605:ELAN9008:00_04F3:2D55_Stylus" map_to_output eDP-1

#启动项
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# 这是waybar的启动脚本，注意路径
exec_always ~/.config/waybar/launch.sh
exec_always mako
exec_always wl-paste --watch cliphist store
# 禁用xcb是因为我的waybar的输入法状态是一个sh监听实现的 如果不禁用的话fcitx的那个巨丑的状态会挂在waybar上面
exec_always --no-startup-id fcitx5 --disable notificationitem --disable xcb -d
# 壁纸（路径记得删掉<>）
exec_always swaybg -o '*' -i <壁纸路径> -m fill

# 音频调节（用的fn的快捷键）
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# 亮度调节（貌似要适配下屏幕）
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
# 我原本是这样的
# bindsym XF86MonBrightnessUp exec sh -c "brightnessctl -d intel_backlight set +5% && brightnessctl -d asus_screenpad set +5%"
# bindsym XF86MonBrightnessDown exec sh -c "brightnessctl -d intel_backlight set 5%- && brightnessctl -d asus_screenpad set 5%-"

# 使用 鼠标+$mod 拖动浮动窗口到想要的位置
floating_modifier $mod


# 启动终端
bindsym $mod+t exec foot

# 启动文件管理器（当然可以指定别的）
bindsym $mod+e exec bennu

# 启动lite xl（文本编辑器）
bindsym $mod+Shift+t exec env -u SDL_IM_MODULE SDL_VIDEODRIVER=wayland lite-xl

# 关闭当前聚焦的窗口
bindsym $mod+q kill

# 启动 rofi
bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons
#bindsym $mod+d exec --no-startup-id rofi -show combi -combi-modi drun#run#window -show-icons


# rofi 阴影效果
layer_effects "rofi" {
    blur enable
    shadows enable
    corner_radius 10
}

# 这一大堆是i3默认配置文件的。。。

# 切换焦点
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right


# 或者，你可以使用方向键：
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# 移动当前聚焦的窗口
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# 或者，你可以使用方向键：
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# 水平方向分割
bindsym $mod+h split h

# 垂直方向分割
bindsym $mod+v split v

# 让当前聚焦的容器进入全屏模式
bindsym $mod+f fullscreen toggle

# 更改容器布局（堆叠、标签页、切换分割）
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
bindsym $mod+w layout toggle split

# 切换平铺/浮动
#bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+space floating toggle, resize set 80ppt 80ppt, move position center


# 在平铺/浮动窗口之间切换焦点
bindsym $mod+space focus mode_toggle

# 聚焦父容器
bindsym $mod+a focus parent

# 聚焦子容器
#bindsym $mod+d focus child

# 为稍后配置键绑定的默认工作区定义名称。
# 我们使用变量来避免在多个位置重复名称。
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# 切换到工作区
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# 将当前聚焦的容器移动到工作区
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# 屏幕排列（单显示器可以不用管）
# output DP-1 position 0 1080
# output eDP-1 position 0 0

# 多屏幕工作区绑定（单显示器可以不用管）
# 主屏（eDP-1）：工作区 1~7
# workspace 1 output eDP-1
# workspace 2 output eDP-1
# workspace 3 output eDP-1
# workspace 4 output eDP-1
# workspace 5 output eDP-1
# workspace 6 output eDP-1
# workspace 7 output eDP-1

# 副屏（DP-1）：工作区 8~10
# workspace 8 output DP-1
# workspace 9 output DP-1
# workspace 10 output DP-1
# 以及原本的工作区绑定
workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output eDP-1
workspace 7 output eDP-1
workspace 8 output eDP-1
workspace 9 output eDP-1
workspace 10 output eDP-1


# 重新加载配置文件
bindsym $mod+Shift+c reload

# 退出 sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# 调整窗口大小
# 我没往waybar上丢这个状态显示。。
mode "resize" {
        # 一旦进入调整大小模式，这些绑定就会立即生效

        # 按左键会缩小窗口宽度。
        # 按右键会增大窗口宽度。
        # 按上键会缩小窗口高度。
        # 按下键会增大窗口高度。
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # 相同的绑定，但使用方向键
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # 返回正常模式：Enter 或 Escape 或 $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"




# 全屏截图保存到 ~/screenshot/
bindsym Print exec grim ~/screenshot/$(date +%F_%H-%M-%S).png

# 区域截图
bindsym $mod+Print exec grim -g "$(slurp)" ~/screenshot/$(date +%F_%H-%M-%S).png

# 区域截图复制到剪贴板
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

# 查看剪贴板历史（rofi 界面）
bindsym $mod+Shift+v exec cliphist list | rofi -dmenu | cliphist decode | wl-copy

# 触摸板滚动方向
input type:touchpad {
    natural_scroll enabled
}


# 以下是swayfx独有的功能
# 动画时长（毫秒）
animation_duration_ms 250

# 窗口圆角半径
corner_radius 2

# 非焦点窗口变暗
#default_dim_inactive 0.09

# 背景模糊
blur enable
blur_radius 10

# 窗口间距
gaps inner 2
gaps outer 2
smart_gaps on


